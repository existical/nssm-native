cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED NSSM_SOURCE_DIR OR NOT DEFINED NSSM_VERSION_HEADER)
  message(FATAL_ERROR "NSSM_SOURCE_DIR and NSSM_VERSION_HEADER are required.")
endif()

file(READ "${NSSM_SOURCE_DIR}/VERSION" base_version)
string(STRIP "${base_version}" base_version)
if(NOT base_version MATCHES "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$")
  message(FATAL_ERROR "VERSION must contain major.minor or major.minor.patch.")
endif()
set(version "${base_version}")
set(revision 0)
set(file_flags VS_FF_PRERELEASE)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${NSSM_SOURCE_DIR}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${NSSM_SOURCE_DIR}"
    describe --tags --long --match "v[0-9]*"
    OUTPUT_VARIABLE description OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET RESULT_VARIABLE git_result)
  if(git_result EQUAL 0 AND description MATCHES
      "^v([0-9]+\\.[0-9]+(\\.[0-9]+)?)-([0-9]+)-g([0-9a-f]+)$")
    set(base_version "${CMAKE_MATCH_1}")
    set(revision "${CMAKE_MATCH_3}")
    string(SUBSTRING "${description}" 1 -1 version)
    if(revision EQUAL 0)
      set(version "${base_version}")
      set(file_flags 0L)
    endif()
  endif()
endif()

string(REPLACE "." ";" version_parts "${base_version}")
list(GET version_parts 0 major)
list(GET version_parts 1 minor)
list(LENGTH version_parts version_length)
if(version_length EQUAL 3)
  list(GET version_parts 2 patch)
  set(version_info "${major},${minor},${patch},${revision}")
else()
  set(patch 0)
  # Preserve the historical two-part tag's Windows version layout.
  set(version_info "${major},${minor},${revision},0")
endif()
foreach(component IN ITEMS major minor patch revision)
  if(${component} GREATER 65535)
    message(FATAL_ERROR "Windows version component ${component} exceeds 65535.")
  endif()
endforeach()
string(TIMESTAMP build_date "%Y-%m-%d" UTC)
set(content "#define NSSM_VERSION _T(\"${version}\")\n#define NSSM_VERSIONINFO ${version_info}\n#define NSSM_DATE _T(\"${build_date}\")\n#define NSSM_FILEFLAGS ${file_flags}\n#define NSSM_COPYRIGHT _T(\"Public Domain; Author Iain Patterson\")\n")
if(EXISTS "${NSSM_VERSION_HEADER}")
  file(READ "${NSSM_VERSION_HEADER}" previous_content)
  if(previous_content STREQUAL content)
    return()
  endif()
endif()
get_filename_component(output_dir "${NSSM_VERSION_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${NSSM_VERSION_HEADER}" "${content}")

{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "inherits": "windows-base",
      "architecture": "x64"
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86 (Visual Studio 2022)",
      "inherits": "windows-base",
      "architecture": "Win32"
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "windows-x86-release", "configurePreset": "windows-x86", "configuration": "Release" },
    { "name": "windows-x86-debug", "configurePreset": "windows-x86", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64", "configuration": "Debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-x86-release", "configurePreset": "windows-x86", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-x86-debug", "configurePreset": "windows-x86", "configuration": "Debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
